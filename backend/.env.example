# Path to your service account JSON key file (see README for how to create one)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Your GCP project ID that owns the BigQuery datasets
GCP_PROJECT_ID=your-project-id

# Comma-separated list of allowed origins for CORS (your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:5173,https://agri-pluse.vercel.app

# Max rows any query/table read is allowed to return (safety cap)
MAX_ROWS=5000

# Gemini API credentials for AI insights and chat
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
